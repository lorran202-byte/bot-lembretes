{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot-lembretes",
  "main": "src/index.js",
  "compatibility_date": "2025-10-08",
  "workers_dev": true,
  // roda a cada minuto para mandar os lembretes na hora certa
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lembretes-treino",
      "database_id": "3d99fc34-628b-4292-936f-97949939ceb4"
    }
  ],
  "observability": {
    "enabled": true
  }
}
